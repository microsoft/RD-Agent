# RD-Agent Configuration Template
# Copy this file to config/settings.yaml and customize as needed.
# All paths are relative to the project root

# Project root directory (use "." for current directory)
project_root: "."

# ==========================================
# Workspace Configuration
# ==========================================
workspace:
  base_path: "${project_root}/workspace"

# ==========================================
# Scenario-Specific Configuration
# ==========================================
qlib:
  qlib_workspace: "${workspace.base_path}/qlib_workspace"
  data_path: "${workspace.qlib_workspace}/qlib_data/cn_data"
  region: cn

kaggle:
  kg_workspace: "${workspace.base_path}/kg_workspace"
  data_path: "${workspace.kg_workspace}/kaggle_data"

finetune:
  finetune_workspace: "${workspace.base_path}/finetune_workspace"
  data_path: "${workspace.finetune_workspace}/finetune_data"

mlebench:
  mlebench_workspace: "${workspace.base_path}/mlebench_workspace"
  data_path: "${workspace.mlebench_workspace}/mlebench_data"

ds:
  ds_workspace: "${workspace.base_path}/ds_workspace"
  data_path: "${workspace.ds_workspace}/ds_data"

# ==========================================
# Environment Configuration
# ==========================================
environment:
  type: "conda"  # "conda" or "docker"
  conda_env_name: "rdagent"
